   "source": [
    "print(\"1.  LINEAR REGRESSION  ΔG‡ ~ Distance\")\n",
    "\n",
    "x = dfa['distance'].values.reshape(-1, 1)\n",
    "y = dfa['deltaG'].values\n",
    " \n",
    "# Simple linear regression\n",
    "lr_simple = LinearRegression().fit(x, y)\n",
    "y_pred_simple = lr_simple.predict(x)\n",
    "r2_simple = r2_score(y, y_pred_simple)\n",
    "mae_simple = mean_absolute_error(y, y_pred_simple)\n",
    "slope, intercept, r_val, p_val, se = stats.linregress(dfa['distance'], dfa['deltaG'])\n",
    " \n",
    "print(f\"\\nSimple Linear Model:  ΔG‡ = {slope:.3f}·d + {intercept:.3f}\")\n",
    "print(f\"  R²  = {r2_simple:.4f}\")\n",
    "print(f\"  MAE = {mae_simple:.3f} kcal/mol\")\n",
    "print(f\"  p   = {p_val:.2e}\")\n",
    "print(f\"  r   = {r_val:.4f}\")\n",
    " \n",
    "# LOO cross-validation\n",
    "loo_scores = cross_val_score(LinearRegression(), x, y,\n",
    "                             cv=LeaveOneOut(), scoring='r2')\n",
    "print(f\"  LOO-CV R² = {loo_scores.mean():.4f} ± {loo_scores.std():.4f}\")\n",
    " \n",
    "# Plot: simple regression\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "fig.suptitle('Analysis 1 — Linear Regression: ΔG‡ vs M–Cl Distance',\n",
    "             fontsize=13, fontweight='bold')\n",
    " \n",
    "metal_colors = {0: '#e74c3c', 1: '#3498db', 2: '#2ecc71', 3: '#95a5a6'}\n",
    "for mid, mname in metal_map.items():\n",
    "    sub = dfa[dfa['metal'] == mid]\n",
    "    axes[0].scatter(sub['distance'], sub['deltaG'],\n",
    "                    color=metal_colors[mid], label=mname,\n",
    "                    s=70, alpha=0.85, edgecolors='white', zorder=3)\n",
    " \n",
    "d_line = np.linspace(dfa['distance'].min(), dfa['distance'].max(), 200)\n",
    "axes[0].plot(d_line, slope * d_line + intercept,\n",
    "             'k--', linewidth=2,\n",
    "             label=f'y = {slope:.2f}d + {intercept:.2f}\\nR²={r2_simple:.3f}  p={p_val:.1e}')\n",
    "axes[0].set_xlabel('M–Cl Distance (Å)', fontsize=11)\n",
    "axes[0].set_ylabel('ΔG‡ (kcal/mol)', fontsize=11)\n",
    "axes[0].set_title('Simple Linear Regression', fontsize=11)\n",
    "axes[0].legend(fontsize=9)\n",
    "axes[0].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "# Residuals\n",
    "residuals = y - y_pred_simple\n",
    "axes[1].axhline(0, color='k', linewidth=1, linestyle='--')\n",
    "for mid, mname in metal_map.items():\n",
    "    sub = dfa[dfa['metal'] == mid]\n",
    "    idx = sub.index\n",
    "    axes[1].scatter(y_pred_simple[dfa.index.get_indexer(idx)],\n",
    "                    residuals[dfa.index.get_indexer(idx)],\n",
    "                    color=metal_colors[mid], label=mname,\n",
    "                    s=60, alpha=0.8, edgecolors='white')\n",
    "axes[1].set_xlabel('Fitted ΔG‡ (kcal/mol)', fontsize=11)\n",
    "axes[1].set_ylabel('Residual (kcal/mol)', fontsize=11)\n",
    "axes[1].set_title('Residuals (simple model)', fontsize=11)\n",
    "axes[1].legend(fontsize=9)\n",
    "axes[1].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "plt.tight_layout()\n",
    "plt.savefig('reg1_simple_linear.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "# Multivariate extension \n",
    "print(\"\\nMultivariate Model:  ΔG‡ ~ distance + metal + scaffold + ligand + is_prime\")\n",
    "feat_multi = ['distance', 'metal', 'scaffold', 'ligand', 'is_prime', 'position']\n",
    "X_multi = dfa[feat_multi].values\n",
    "lr_multi = LinearRegression().fit(X_multi, y)\n",
    "y_pred_multi = lr_multi.predict(X_multi)\n",
    "r2_multi  = r2_score(y, y_pred_multi)\n",
    "mae_multi = mean_absolute_error(y, y_pred_multi)\n",
    "loo_multi = cross_val_score(LinearRegression(), X_multi, y,\n",
    "                            cv=LeaveOneOut(), scoring='r2')\n",
    " \n",
    "print(f\"  R²  = {r2_multi:.4f}\")\n",
    "print(f\"  MAE = {mae_multi:.3f} kcal/mol\")\n",
    "print(f\"  LOO-CV R² = {loo_multi.mean():.4f} ± {loo_multi.std():.4f}\")\n",
    "print(\"\\n  Coefficients:\")\n",
    "for fname, coef in zip(feat_multi, lr_multi.coef_):\n",
    "    print(f\"    {fname:<12} {coef:+.4f}\")\n",
    "print(f\"    intercept    {lr_multi.intercept_:+.4f}\")\n",
    " \n",
    "# Parity plot: simple vs multivariate\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "ax.scatter(y, y_pred_simple, color='#e74c3c', s=60, alpha=0.7,\n",
    "           label=f'Simple  R²={r2_simple:.3f}', zorder=3)\n",
    "ax.scatter(y, y_pred_multi,  color='#3498db', s=60, alpha=0.7,\n",
    "           marker='s', label=f'Multivariate  R²={r2_multi:.3f}', zorder=3)\n",
    "lims = [min(y.min(), y_pred_simple.min(), y_pred_multi.min()) - 1,\n",
    "        max(y.max(), y_pred_simple.max(), y_pred_multi.max()) + 1]\n",
    "ax.plot(lims, lims, 'k--', linewidth=1.5, label='Perfect prediction')\n",
    "ax.set_xlabel('DFT ΔG‡ (kcal/mol)', fontsize=12)\n",
    "ax.set_ylabel('Predicted ΔG‡ (kcal/mol)', fontsize=12)\n",
    "ax.set_title('Parity Plot: Simple vs Multivariate Regression', fontsize=12, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
    "ax.grid(True, linestyle='--', alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('reg1_parity.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "print(f\"\\n→ Distance alone explains {r2_simple*100:.1f}% of variance.\")\n",
    "print(f\"→ Adding metal/scaffold/ligand raises R² to {r2_multi*100:.1f}%.\")\n",
    "if r2_multi - r2_simple > 0.15:\n",
    "    print(\"→ Multivariate model is substantially better — distance alone is insufficient.\")\n",
    "else:\n",
    "    print(\"→ Distance is the dominant predictor; additional features give modest improvement.\")\n",
    " "
   ]
