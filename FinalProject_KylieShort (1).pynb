   "source": [
    "print(\"3.  CORRELATED FITS & INTERDEPENDENCY TESTING\")\n",
    " \n",
    "cont_feats = ['deltaG', 'distance', 'scaffold', 'metal', 'ligand', 'position']\n",
    "corr_df = dfa[cont_feats].copy()\n",
    " \n",
    "# Pearson correlation matrix\n",
    "pearson_r = corr_df.corr(method='pearson')\n",
    "spearman_r = corr_df.corr(method='spearman')\n",
    " \n",
    "# p-value matrix (Pearson)\n",
    "n = len(corr_df)\n",
    "p_matrix = pd.DataFrame(np.nan, index=cont_feats, columns=cont_feats)\n",
    "for f1 in cont_feats:\n",
    "    for f2 in cont_feats:\n",
    "        if f1 != f2:\n",
    "            _, p = pearsonr(corr_df[f1], corr_df[f2])\n",
    "            p_matrix.loc[f1, f2] = p\n",
    " \n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "fig.suptitle('Analysis 4 — Correlation & Interdependency', fontsize=13, fontweight='bold')\n",
    " \n",
    "import matplotlib.colors as mcolors\n",
    "cmap = 'RdBu_r'\n",
    " \n",
    "im0 = axes[0].imshow(pearson_r.values, cmap=cmap, vmin=-1, vmax=1, aspect='auto')\n",
    "axes[0].set_xticks(range(len(cont_feats)))\n",
    "axes[0].set_yticks(range(len(cont_feats)))\n",
    "axes[0].set_xticklabels(cont_feats, rotation=45, ha='right', fontsize=9)\n",
    "axes[0].set_yticklabels(cont_feats, fontsize=9)\n",
    "for i in range(len(cont_feats)):\n",
    "    for j in range(len(cont_feats)):\n",
    "        val = pearson_r.values[i, j]\n",
    "        pval = p_matrix.values[i, j]\n",
    "        sig = '*' if (not np.isnan(pval) and pval < 0.05) else ''\n",
    "        axes[0].text(j, i, f'{val:.2f}{sig}', ha='center', va='center',\n",
    "                     fontsize=8, color='white' if abs(val) > 0.5 else 'black')\n",
    "plt.colorbar(im0, ax=axes[0])\n",
    "axes[0].set_title('Pearson r  (* p<0.05)', fontsize=11)\n",
    " \n",
    "im1 = axes[1].imshow(spearman_r.values, cmap=cmap, vmin=-1, vmax=1, aspect='auto')\n",
    "axes[1].set_xticks(range(len(cont_feats)))\n",
    "axes[1].set_yticks(range(len(cont_feats)))\n",
    "axes[1].set_xticklabels(cont_feats, rotation=45, ha='right', fontsize=9)\n",
    "axes[1].set_yticklabels(cont_feats, fontsize=9)\n",
    "for i in range(len(cont_feats)):\n",
    "    for j in range(len(cont_feats)):\n",
    "        val = spearman_r.values[i, j]\n",
    "        axes[1].text(j, i, f'{val:.2f}', ha='center', va='center',\n",
    "                     fontsize=8, color='white' if abs(val) > 0.5 else 'black')\n",
    "plt.colorbar(im1, ax=axes[1])\n",
    "axes[1].set_title('Spearman ρ', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.savefig('corr_heatmap.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "# ── Kruskal-Wallis: does metal significantly affect ΔG‡? ──\n",
    "print(\"\\nKruskal-Wallis test: does metal significantly affect ΔG‡?\")\n",
    "groups_by_metal = [dfa[dfa['metal'] == m]['deltaG'].dropna().values\n",
    "                   for m in sorted(dfa['metal'].unique())]\n",
    "kw_stat, kw_p = stats.kruskal(*groups_by_metal)\n",
    "print(f\"  H = {kw_stat:.3f},  p = {kw_p:.4e}\")\n",
    "print(\"  → Metal identity significantly affects ΔG‡\" if kw_p < 0.05 else\n",
    "      \"  → No significant metal effect detected\")\n",
    " \n",
    "# ── Mn(CO)₃ interdependency: distance ranges ──────────────\n",
    "print(\"\\nDo Mn(CO)₃ complexes access different distance ranges than Fe/Ru-Cp?\")\n",
    "mn_dist  = dfa[dfa['metal'] == 2]['distance'].dropna()\n",
    "feru_dist = dfa[dfa['metal'].isin([0, 1])]['distance'].dropna()\n",
    "mw_stat, mw_p = stats.mannwhitneyu(mn_dist, feru_dist, alternative='two-sided')\n",
    "print(f\"  Mn(CO)₃  distances:  {mn_dist.mean():.2f} ± {mn_dist.std():.2f} Å\")\n",
    "print(f\"  Fe/Ru-Cp distances:  {feru_dist.mean():.2f} ± {feru_dist.std():.2f} Å\")\n",
    "print(f\"  Mann-Whitney U = {mw_stat:.1f},  p = {mw_p:.4e}\")\n",
    "print(\"  → Mn(CO)₃ and Fe/Ru-Cp span statistically different distance regimes\" if mw_p < 0.05 else\n",
    "      \"  → No significant difference in distance ranges\")\n",
    " \n",
    "# ── Partial correlation: ΔG‡ ~ distance controlling for metal ──\n",
    "print(\"\\nPartial correlation (ΔG‡ ~ distance, controlling for metal):\")\n",
    "# Residualise both ΔG and distance on metal dummies\n",
    "metal_dummies = pd.get_dummies(dfa['metal'], prefix='metal', drop_first=True)\n",
    "X_ctrl = sm.add_constant(metal_dummies.astype(float))\n",
    "res_dG   = sm.OLS(dfa['deltaG'].values, X_ctrl).fit().resid\n",
    "res_dist = sm.OLS(dfa['distance'].values, X_ctrl).fit().resid\n",
    "part_r, part_p = pearsonr(res_dG, res_dist)\n",
    "print(f\"  Partial r = {part_r:.4f},  p = {part_p:.4e}\")\n",
    "print(\"  → Distance effect on ΔG‡ persists even after removing metal variation\" if part_p < 0.05 else\n",
    "      \"  → Distance correlation is largely mediated by metal identity\")\n",
    " \n",
    "# ── Stratified regression: fit separate slopes per metal ──\n",
    "print(\"\\nStratified linear regression (slope of ΔG‡ ~ distance per metal):\")\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "for mid, mname in metal_map.items():\n",
    "    sub = dfa[dfa['metal'] == mid].dropna(subset=['deltaG', 'distance'])\n",
    "    if len(sub) < 4:\n",
    "        continue\n",
    "    m, b, r, p, _ = stats.linregress(sub['distance'], sub['deltaG'])\n",
    "    color = metal_colors[mid]\n",
    "    ax.scatter(sub['distance'], sub['deltaG'], color=color, s=60,\n",
    "               alpha=0.8, edgecolors='white', label=f'{mname}  (n={len(sub)})', zorder=3)\n",
    "    d_range = np.linspace(sub['distance'].min(), sub['distance'].max(), 100)\n",
    "    ax.plot(d_range, m * d_range + b, color=color, linewidth=2,\n",
    "            linestyle='--' if p > 0.05 else '-')\n",
    "    print(f\"  {mname:<4} slope={m:+.3f}  R²={r**2:.3f}  p={p:.3f}\")\n",
    " \n",
    "ax.set_xlabel('M–Cl Distance (Å)', fontsize=12)\n",
    "ax.set_ylabel('ΔG‡ (kcal/mol)', fontsize=12)\n",
    "ax.set_title('Stratified Regression per Metal\\n(solid = p<0.05, dashed = p≥0.05)',\n",
    "             fontsize=12, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
    "ax.grid(True, linestyle='--', alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('stratified_regression.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " "
   ]
  },
