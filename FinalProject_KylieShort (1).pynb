   "source": [
    "print(\"4.  UNCERTAINTY PROPAGATION\")\n",
    " \n",
    "# ── 5a. DFT systematic uncertainty ───────────────────────\n",
    "# Conservative literature estimate for ωB97X-D / def2-SVP\n",
    "# single-point corrections: ~1.0–2.0 kcal/mol\n",
    "dft_systematic_kcal = 1.5\n",
    "print(f\"\\nDFT systematic uncertainty (ωB97X-D/def2-SVP, literature): ±{dft_systematic_kcal} kcal/mol\")\n",
    " \n",
    "# ── 5b. Statistical (sampling) uncertainty per group ─────\n",
    "print(\"\\nGroup-level statistical uncertainties (95% CI on mean ΔG‡):\")\n",
    "group_stats = []\n",
    "for mid, mname in metal_map.items():\n",
    "    sub = dfa[dfa['metal'] == mid]['deltaG'].dropna()\n",
    "    if len(sub) < 2:\n",
    "        continue\n",
    "    se_mean = sub.sem()\n",
    "    ci95 = stats.t.ppf(0.975, df=len(sub) - 1) * se_mean\n",
    "    group_stats.append({\n",
    "        'Metal': mname,\n",
    "        'n': len(sub),\n",
    "        'mean_dG': sub.mean(),\n",
    "        'SE': se_mean,\n",
    "        'CI95': ci95,\n",
    "    })\n",
    "    print(f\"  {mname:<4}  n={len(sub):2d}  mean={sub.mean():.2f}  SE={se_mean:.2f}  95% CI=±{ci95:.2f} kcal/mol\")\n",
    " \n",
    "# ── 5c. OLS prediction uncertainty ───────────────────────\n",
    "print(\"\\nOLS prediction uncertainties (individual prediction intervals):\")\n",
    "# Prediction interval at each observed data point\n",
    "y_pred_ols = ols_model.predict(X_ols_const)\n",
    "pred_frame = ols_model.get_prediction(X_ols_const).summary_frame(alpha=0.05)\n",
    "pi_half_width = (pred_frame['obs_ci_upper'] - pred_frame['obs_ci_lower']) / 2\n",
    "print(f\"  Mean prediction interval half-width: ±{pi_half_width.mean():.2f} kcal/mol\")\n",
    "print(f\"  Range: [{pi_half_width.min():.2f}, {pi_half_width.max():.2f}] kcal/mol\")\n",
    " \n",
    "# ── 5d. Monte Carlo error propagation ────────────────────\n",
    "# Simulate perturbed ΔG‡ by adding Gaussian noise at the DFT level,\n",
    "# then refit the linear model and track how coefficient uncertainty grows\n",
    "np.random.seed(42)\n",
    "n_mc = 2000\n",
    "mc_slopes = []\n",
    "mc_r2     = []\n",
    " \n",
    "for _ in range(n_mc):\n",
    "    y_noisy = y + np.random.normal(0, dft_systematic_kcal, size=len(y))\n",
    "    m_mc, b_mc, r_mc, _, _ = stats.linregress(dfa['distance'], y_noisy)\n",
    "    mc_slopes.append(m_mc)\n",
    "    mc_r2.append(r_mc ** 2)\n",
    " \n",
    "mc_slopes = np.array(mc_slopes)\n",
    "mc_r2     = np.array(mc_r2)\n",
    " \n",
    "print(f\"\\nMonte Carlo uncertainty (n={n_mc} perturbations, σ_DFT={dft_systematic_kcal} kcal/mol):\")\n",
    "print(f\"  Slope distribution:  {mc_slopes.mean():.4f} ± {mc_slopes.std():.4f}  kcal/mol per Å\")\n",
    "print(f\"  R² distribution:     {mc_r2.mean():.4f} ± {mc_r2.std():.4f}\")\n",
    "print(f\"  P(R² > 0.5):         {(mc_r2 > 0.5).mean() * 100:.1f}%\")\n",
    " \n",
    "# ── 5e. Combined uncertainty ──────────────────────────────\n",
    "# Quadrature combination of systematic + statistical\n",
    "stat_unc = pi_half_width.mean()  # from OLS\n",
    "combined_unc = np.sqrt(dft_systematic_kcal**2 + stat_unc**2)\n",
    "print(f\"\\nCombined uncertainty (quadrature):\")\n",
    "print(f\"  σ_DFT    = {dft_systematic_kcal:.2f} kcal/mol\")\n",
    "print(f\"  σ_stat   = {stat_unc:.2f} kcal/mol  (OLS prediction SE)\")\n",
    "print(f\"  σ_total  = √(σ_DFT² + σ_stat²) = {combined_unc:.2f} kcal/mol\")\n",
    " \n",
    "# ── Plots ─────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "fig.suptitle('Analysis 5 — Uncertainty Propagation', fontsize=13, fontweight='bold')\n",
    " \n",
    "# (a) ΔG‡ with DFT error bars per metal\n",
    "for mid, mname in metal_map.items():\n",
    "    sub = dfa[dfa['metal'] == mid].dropna(subset=['deltaG', 'distance'])\n",
    "    if len(sub) == 0:\n",
    "        continue\n",
    "    axes[0].errorbar(sub['distance'], sub['deltaG'],\n",
    "                     yerr=dft_systematic_kcal,\n",
    "                     fmt='o', color=metal_colors[mid],\n",
    "                     ecolor=metal_colors[mid], alpha=0.6,\n",
    "                     capsize=3, capthick=1.5, markersize=6,\n",
    "                     label=mname, elinewidth=1)\n",
    "axes[0].set_xlabel('M–Cl Distance (Å)', fontsize=11)\n",
    "axes[0].set_ylabel('ΔG‡ (kcal/mol)', fontsize=11)\n",
    "axes[0].set_title(f'DFT Systematic Errors (±{dft_systematic_kcal} kcal/mol)', fontsize=11)\n",
    "axes[0].legend(fontsize=9)\n",
    "axes[0].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "# (b) Monte Carlo slope distribution\n",
    "axes[1].hist(mc_slopes, bins=40, color='#3498db', edgecolor='white', alpha=0.85)\n",
    "axes[1].axvline(slope, color='k', linewidth=2, label=f'OLS slope = {slope:.3f}')\n",
    "axes[1].axvline(mc_slopes.mean(), color='#e74c3c', linewidth=2,\n",
    "                linestyle='--', label=f'MC mean = {mc_slopes.mean():.3f}')\n",
    "axes[1].fill_betweenx([0, axes[1].get_ylim()[1] if True else 50],\n",
    "                       mc_slopes.mean() - mc_slopes.std(),\n",
    "                       mc_slopes.mean() + mc_slopes.std(),\n",
    "                       alpha=0.2, color='#e74c3c', label=f'±1σ ({mc_slopes.std():.3f})')\n",
    "axes[1].set_xlabel('Slope (kcal/mol per Å)', fontsize=11)\n",
    "axes[1].set_ylabel('Frequency', fontsize=11)\n",
    "axes[1].set_title('MC Slope Distribution', fontsize=11)\n",
    "axes[1].legend(fontsize=9)\n",
    "axes[1].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "# (c) OLS prediction intervals\n",
    "sort_idx = np.argsort(y_pred_ols)\n",
    "axes[2].scatter(dfa['distance'].values, y, s=50, color='#2ecc71', alpha=0.7,\n",
    "                label='DFT data', zorder=3)\n",
    "axes[2].plot(dfa['distance'].values[sort_idx], y_pred_ols.values[sort_idx],\n",
    "             'k-', linewidth=2, label='OLS fit')\n",
    "axes[2].fill_between(dfa['distance'].values[sort_idx],\n",
    "                      pred_frame['obs_ci_lower'].values[sort_idx],\n",
    "                      pred_frame['obs_ci_upper'].values[sort_idx],\n",
    "                      alpha=0.2, color='#3498db', label='95% Prediction Interval')\n",
    "axes[2].fill_between(dfa['distance'].values[sort_idx],\n",
    "                      pred_frame['mean_ci_lower'].values[sort_idx],\n",
    "                      pred_frame['mean_ci_upper'].values[sort_idx],\n",
    "                      alpha=0.35, color='#e74c3c', label='95% Confidence Interval (mean)')\n",
    "axes[2].set_xlabel('M–Cl Distance (Å)', fontsize=11)\n",
    "axes[2].set_ylabel('ΔG‡ (kcal/mol)', fontsize=11)\n",
    "axes[2].set_title('OLS Prediction & Confidence Intervals', fontsize=11)\n",
    "axes[2].legend(fontsize=8)\n",
    "axes[2].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "plt.tight_layout()\n",
    "plt.savefig('uncertainty_propagation.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "\n",
    "# SUMMARY TABLE\n",
    "print(\"SUMMARY OF ALL ANALYSES\")\n",
    "print(f\"\"\"\n",
    "┌─────────────────────────────────────────────────────────┐\n",
    "│  Analysis                          Key Result           │\n",
    "├─────────────────────────────────────────────────────────┤\n",
    "│  1. Linear regression (distance)   R² = {r2_simple:.3f} \n",
    "│     Multivariate model             R² = {r2_multi:.3f}  \n",
    "│     LOO-CV (multivariate)          R² = {loo_multi.mean():.3f}            \n",
    "├─────────────────────────────────────────────────────────┤\n",
    "│  2. OLS Adj. R²                    {ols_model.rsquared_adj:.3f}           \n",
    "│     F-test p-value                 {ols_model.f_pvalue:.2e}       \n",
    "├─────────────────────────────────────────────────────────┤\n",
    "│  3. Partial r (dist|metal)         {part_r:.3f}  p={part_p:.2e}  \n",
    "│     Kruskal-Wallis (metal effect)  p = {kw_p:.2e}       \n",
    "│     Mn vs Fe/Ru distance range     p = {mw_p:.2e}       \n",
    "├─────────────────────────────────────────────────────────┤\n",
    "│  4. DFT systematic uncertainty     ±{dft_systematic_kcal:.1f} kcal/mol         \n",
    "│     OLS prediction PI half-width   ±{pi_half_width.mean():.2f} kcal/mol  \n",
    "│     Combined (quadrature)          ±{combined_unc:.2f} kcal/mol  \n",
    "└─────────────────────────────────────────────────────────┘\n",
    "\"\"\")\n",
    " \n",
    "\n"
   ]
  },
