   "source": [
    "print(\"2.  OLS LEAST-SQUARES REGRESSION (statsmodels)\")\n",
    " \n",
    "# Build OLS design matrix with constants\n",
    "X_ols = dfa[feat_multi].copy()\n",
    "X_ols_const = sm.add_constant(X_ols)\n",
    " \n",
    "ols_model = sm.OLS(y, X_ols_const).fit()\n",
    "print(ols_model.summary())\n",
    " \n",
    "# VIF for multicollinearity\n",
    "print(\"\\nVariance Inflation Factors (VIF):\")\n",
    "print(\"  (VIF > 5 = problematic collinearity)\")\n",
    "for i, col in enumerate(X_ols_const.columns):\n",
    "    if col == 'const':\n",
    "        continue\n",
    "    vif = variance_inflation_factor(X_ols_const.values, i)\n",
    "    flag = \" ⚠\" if vif > 5 else \"\"\n",
    "    print(f\"  {col:<14}  VIF = {vif:.2f}{flag}\")\n",
    " \n",
    "# Confidence interval plot for coefficients\n",
    "ci = ols_model.conf_int()\n",
    "ci.columns = ['lower', 'upper']\n",
    "ci['coef'] = ols_model.params\n",
    "ci = ci.drop('const')\n",
    " \n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "y_pos = range(len(ci))\n",
    "ax.axvline(0, color='k', linewidth=1, linestyle='--')\n",
    "for i, (feat, row) in enumerate(ci.iterrows()):\n",
    "    color = '#e74c3c' if (row['lower'] > 0 or row['upper'] < 0) else '#95a5a6'\n",
    "    ax.errorbar(row['coef'], i,\n",
    "                xerr=[[row['coef'] - row['lower']], [row['upper'] - row['coef']]],\n",
    "                fmt='o', color=color, capsize=6, capthick=2, markersize=8, linewidth=2)\n",
    "ax.set_yticks(list(y_pos))\n",
    "ax.set_yticklabels(ci.index, fontsize=11)\n",
    "ax.set_xlabel('OLS Coefficient (95% CI)', fontsize=11)\n",
    "ax.set_title('OLS Regression Coefficients with 95% Confidence Intervals\\n'\n",
    "             '(red = significant, grey = not significant)', fontsize=11, fontweight='bold')\n",
    "ax.grid(True, axis='x', linestyle='--', alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('ols_coefficients.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "# Residual diagnostics\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
    "fig.suptitle('OLS Residual Diagnostics', fontsize=12, fontweight='bold')\n",
    " \n",
    "ols_resid = ols_model.resid\n",
    "ols_fitted = ols_model.fittedvalues\n",
    " \n",
    "axes[0].scatter(ols_fitted, ols_resid, s=50, alpha=0.7, color='#3498db', edgecolors='white')\n",
    "axes[0].axhline(0, color='k', linewidth=1, linestyle='--')\n",
    "axes[0].set_xlabel('Fitted ΔG‡', fontsize=11)\n",
    "axes[0].set_ylabel('Residual', fontsize=11)\n",
    "axes[0].set_title('Residuals vs Fitted', fontsize=11)\n",
    "axes[0].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "sm.qqplot(ols_resid, line='s', ax=axes[1], alpha=0.6)\n",
    "axes[1].set_title('Normal Q-Q Plot of Residuals', fontsize=11)\n",
    "axes[1].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "axes[2].hist(ols_resid, bins=15, color='#2ecc71', edgecolor='white', alpha=0.8)\n",
    "axes[2].set_xlabel('Residual (kcal/mol)', fontsize=11)\n",
    "axes[2].set_ylabel('Count', fontsize=11)\n",
    "axes[2].set_title('Residual Distribution', fontsize=11)\n",
    "axes[2].grid(True, linestyle='--', alpha=0.3)\n",
    " \n",
    "plt.tight_layout()\n",
    "plt.savefig('ols_diagnostics.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    " \n",
    "print(f\"\\nOLS Summary:\")\n",
