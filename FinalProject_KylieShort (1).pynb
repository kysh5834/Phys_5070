   "source": [
    "#  Fit K-Means k=3 \n",
    "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
    "df_km['cluster'] = kmeans.fit_predict(X_km)\n",
    "\n",
    "# Sort clusters by ascending mean ΔG\n",
    "order_km = df_km.groupby('cluster')['deltaG_f'].mean().sort_values().index\n",
    "mapping_km = {old: new for new, old in enumerate(order_km)}\n",
    "df_km['cluster'] = df_km['cluster'].map(mapping_km)\n",
    "\n",
    "# Cluster descriptions\n",
    "cluster_labels_km = {}\n",
    "for c in range(3):\n",
    "    sub = df_km[df_km['cluster'] == c]\n",
    "    tm  = sub['metal'].mode()[0]\n",
    "    ts  = sub['scaffold'].mode()[0]\n",
    "    mdG = sub['deltaG'].mean()\n",
    "    cluster_labels_km[c] = (\n",
    "        f\"C{c}: {metal_map[tm]} / {scaf_map[ts]}\"\n",
    "        f\"  (n={len(sub)}, mean ΔG={mdG:.1f} kcal/mol)\"\n",
    "    )\n",
    "\n"
   ]
  },
